# ML data is reproducible or externally sourced; do not commit it by default
ml/data/raw/
ml/data/external/
ml/data/interim/
ml/data/processed/

# Never commit serialized model binaries; track manifests and model cards instead
# EXCEPTION: For this deployment, we commit the core .joblib models
*.joblib
!ml/models/*.joblib
*.pkl
*.pickle
*.onnx
*.h5
*.pt
*.pth
*.ckpt

