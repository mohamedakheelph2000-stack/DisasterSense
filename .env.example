# DisasterSense — Root Environment Variables Example
#
# Copy this file to .env at the project root for docker-compose usage.
# NEVER commit .env to version control.
#
# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=disastersense
POSTGRES_USER=disastersense
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_PORT=5432

# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://disastersense:CHANGE_ME_PASSWORD@db:5432/disastersense
SECRET_KEY=REPLACE_ME_WITH_64_HEX_CHARS
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
# Public environment variables for Next.js (prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:8000
