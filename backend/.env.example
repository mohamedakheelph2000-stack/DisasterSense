# DisasterSense Backend Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# DO NOT COMMIT REAL SECRETS.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="DisasterSense API"
APP_VERSION="0.1.0"
# Set to 'production' for public deployments
APP_ENV="development"
# Set to false in production to disable verbose logging
DEBUG=True

# ── API ───────────────────────────────────────────────────────────────────────
API_V1_PREFIX="/api/v1"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production, set this to your Vercel frontend URL (e.g., https://disastersense.vercel.app)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection URL.
# Example: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://disastersense:changeme@localhost:5432/disastersense"

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a secure 32-byte hex string for production!
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="REPLACE_ME_WITH_A_REAL_SECRET_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Notifications (Optional) ──────────────────────────────────────────────────
# SMTP details for email alerts
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="your-email@example.com"
# SMTP_PASS="your-secure-app-password"

# SMS details (Twilio Example)
# TWILIO_ACCOUNT_SID="your-account-sid"
# TWILIO_AUTH_TOKEN="your-auth-token"
# TWILIO_FROM_NUMBER="+1234567890"
