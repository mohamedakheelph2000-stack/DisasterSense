# DisasterSense Frontend Environment Configuration
# Copy this file to .env.local and fill in the values for your environment.
# DO NOT COMMIT REAL SECRETS.

# The public URL of your FastAPI backend. 
# For local development, this is typically http://localhost:8000/api/v1
# In production, set this to your Render/Backend URL (e.g., https://api.disastersense.example.com/api/v1)
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# Controls whether the frontend uses mock safe data (true) or live data (false)
# MUST BE FALSE IN PRODUCTION
NEXT_PUBLIC_DEMO_MODE="false"
